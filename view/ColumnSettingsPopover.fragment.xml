<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Popover
        id="colSettingsPopover"
        placement="Bottom"
        showArrow="false"
        contentWidth="30rem"
        class="sapUiSizeCompact sapUiNoContentPadding aribaColSettingsPopover"
    >
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Column Settings" titleStyle="H5" />
                </contentLeft>
                <contentRight>
                    <Button
                        icon="sap-icon://decline"
                        type="Transparent"
                        tooltip="Close"
                        press=".onColSettingsClose"
                    />
                </contentRight>
            </Bar>
        </customHeader>

        <!-- Sort By -->
        <List headerText="Sort By" showSeparators="All" showNoData="false" class="aribaColSettingsList">
            <InputListItem label="PR Title">
                <SegmentedButton selectedKey="{colSettings>/sort_PR Title}" selectionChange=".onColSettingsSortChange">
                    <items>
                        <SegmentedButtonItem key="none" icon="sap-icon://menu2"           tooltip="No Sort"         />
                        <SegmentedButtonItem key="asc"  icon="sap-icon://sort-ascending"  tooltip="Sort Ascending"  />
                        <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="Sort Descending" />
                    </items>
                </SegmentedButton>
            </InputListItem>
            <InputListItem label="Status">
                <SegmentedButton selectedKey="{colSettings>/sort_Status}" selectionChange=".onColSettingsSortChange">
                    <items>
                        <SegmentedButtonItem key="none" icon="sap-icon://menu2"           tooltip="No Sort"         />
                        <SegmentedButtonItem key="asc"  icon="sap-icon://sort-ascending"  tooltip="Sort Ascending"  />
                        <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="Sort Descending" />
                    </items>
                </SegmentedButton>
            </InputListItem>
            <InputListItem label="Requester">
                <SegmentedButton selectedKey="{colSettings>/sort_Requester}" selectionChange=".onColSettingsSortChange">
                    <items>
                        <SegmentedButtonItem key="none" icon="sap-icon://menu2"           tooltip="No Sort"         />
                        <SegmentedButtonItem key="asc"  icon="sap-icon://sort-ascending"  tooltip="Sort Ascending"  />
                        <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="Sort Descending" />
                    </items>
                </SegmentedButton>
            </InputListItem>
            <InputListItem label="Supplier">
                <SegmentedButton selectedKey="{colSettings>/sort_Supplier}" selectionChange=".onColSettingsSortChange">
                    <items>
                        <SegmentedButtonItem key="none" icon="sap-icon://menu2"           tooltip="No Sort"         />
                        <SegmentedButtonItem key="asc"  icon="sap-icon://sort-ascending"  tooltip="Sort Ascending"  />
                        <SegmentedButtonItem key="desc" icon="sap-icon://sort-descending" tooltip="Sort Descending" />
                    </items>
                </SegmentedButton>
            </InputListItem>
        </List>

        <!-- Group By -->
        <List headerText="Group By" showSeparators="All" showNoData="false" class="aribaColSettingsList">
            <InputListItem label="PR Title">
                <Switch state="{colSettings>/group_PR Title}" change=".onColSettingsGroupByChange" />
            </InputListItem>
            <InputListItem label="Status">
                <Switch state="{colSettings>/group_Status}" change=".onColSettingsGroupByChange" />
            </InputListItem>
            <InputListItem label="Requester">
                <Switch state="{colSettings>/group_Requester}" change=".onColSettingsGroupByChange" />
            </InputListItem>
            <InputListItem label="Supplier">
                <Switch state="{colSettings>/group_Supplier}" change=".onColSettingsGroupByChange" />
            </InputListItem>
        </List>

        <!-- More Column Settings -->
        <List headerText="More Column Settings" showSeparators="All" showNoData="false" class="aribaColSettingsList">
            <InputListItem label="Resize column width (pixel)">
                <StepInput
                    value="{colSettings>/columnWidthPx}"
                    min="80"
                    max="600"
                    step="10"
                    textAlign="Center"
                    width="5.5rem"
                    change=".onColSettingsWidthChange"
                />
            </InputListItem>
        </List>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    icon="sap-icon://action-settings"
                    type="Transparent"
                    tooltip="More Column Settings"
                    press=".onColSettingsMore"
                    class="aribaColSettingsMoreBtn"
                />
            </OverflowToolbar>
        </footer>

    </Popover>
</core:FragmentDefinition>
